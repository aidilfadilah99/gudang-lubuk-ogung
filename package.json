{
  "name": "gudang-lubuk-ogung",
  "version": "1.0.0",
  "private": true,
  "description": "Sistem Pergudangan Barang KDKMP Lubuk Ogung - MVP Tahap 1",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "build": "npm run db:setup && next build",
    "start": "next start",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check:arch": "node scripts/check-arch.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --audit-level=high",
    "verify": "npm ci && npm audit signatures",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/shared/db/migrate.ts",
    "db:seed": "tsx src/shared/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@serwist/next": "9.5.13",
    "@zxing/library": "0.21.3",
    "bcryptjs": "3.0.2",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "lucide-react": "1.57.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serwist": "9.5.13",
    "tailwind-merge": "3.0.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.21.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.0.4",
    "drizzle-kit": "0.31.11",
    "eslint": "9.21.0",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
