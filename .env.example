# Database (Neon Serverless PostgreSQL Pooled Connection String)
DATABASE_URL="postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Authentication Secret (Min 32 characters random hex/base64)
AUTH_SECRET="ganti-dengan-secret-acak-minimal-32-karakter-aman"

# Default Warehouse Configuration
DEFAULT_WAREHOUSE_ID="wh_lubuk_ogung_01"
DEFAULT_WAREHOUSE_NAME="Gudang Utama KDKMP Lubuk Ogung"

# Seed Initial Admin (Hanya dipakai saat menjalankan npm run db:seed)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="GantiPasswordSegera123!"

# Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Sistem Pergudangan KDKMP Lubuk Ogung"
